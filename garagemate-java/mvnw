set -e

# Resolve the wrapper JAR
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-}"
if [ -z "$MAVEN_PROJECTBASEDIR" ]; then
  MAVEN_PROJECTBASEDIR="$(pwd)"
fi
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Download distribution
DISTRIBUTION_URL=$(grep "distributionUrl" "$WRAPPER_PROPERTIES" | sed 's/distributionUrl=//')
DISTRIBUTION_URL="${DISTRIBUTION_URL%%[[:space:]]}"

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
WRAPPER_JAR="$MAVEN_USER_HOME/wrapper/dists/maven-wrapper.jar"

# Use JAVA_HOME if set
if [ -n "$JAVA_HOME" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
else
  JAVA_CMD="java"
fi

WRAPPER_JAR_DIR="$MAVEN_USER_HOME/wrapper"
mkdir -p "$WRAPPER_JAR_DIR"

if [ ! -f "$WRAPPER_JAR_DIR/maven-wrapper.jar" ]; then
  WRAPPER_URL=$(grep "wrapperUrl" "$WRAPPER_PROPERTIES" | sed 's/wrapperUrl=//')
  WRAPPER_URL="${WRAPPER_URL%%[[:space:]]}"
  if command -v curl > /dev/null; then
    curl -fsL "$WRAPPER_URL" -o "$WRAPPER_JAR_DIR/maven-wrapper.jar"
  elif command -v wget > /dev/null; then
    wget -q "$WRAPPER_URL" -O "$WRAPPER_JAR_DIR/maven-wrapper.jar"
  fi
fi

exec "$JAVA_CMD" \
  -classpath "$WRAPPER_JAR_DIR/maven-wrapper.jar" \
  org.apache.maven.wrapper.MavenWrapperMain \
  -MavenWrapperProperties="$WRAPPER_PROPERTIES" \
  "$@"